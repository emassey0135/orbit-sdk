<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Waking the device as something comes to the front (`Foreground`). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The services the SDK binds, and the File Manager it asks to pick files (`FilePicker`):
         Android 11 hides other apps' packages from a target of 30. -->
    <queries>
        <package android:name="com.orbit.screenreader" />
        <package android:name="com.orbit.liblouisservice" />
        <package android:name="com.orbit.filemanager" />
    </queries>
</manifest>
